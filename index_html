    const campaignForm = document.getElementById('campaignForm');
    if(campaignForm) campaignForm.addEventListener('submit', e=>{
      e.preventDefault();
      const f = e.target;
      const total = Number(f.totalAmount.value)||0;
      const title = f.title.value.trim();
      const group = f.targetGroup.value;
      const startMonth = f.startMonth.value || currentMonth;
      const fundType = f.isElevator && f.isElevator.checked ? 'elevator' : 'general';
      if(!state.commitments) state.commitments=[];
      let targets = state.apartments.filter(a=>a.occupied);
      if(group==='elevator') targets = targets.filter(a=>a.elevator);
      else if(group==='noElevator') targets = targets.filter(a=>!a.elevator);
      if(total<=0 || targets.length===0){
        alert('لازم مبلغ أكبر من صفر، ولازم يكون فيه شقق في المجموعة اللي اخترتها.');
        return;
      }
      const count = targets.length;
      const base = Math.floor(total / count);
      const remainder = total - base*count;
      const campaignId = 'camp'+Date.now();
      targets.forEach((apt, idx)=>{
        const share = base + (idx < remainder ? 1 : 0);
        state.commitments.push({
          id: 'c'+Date.now()+'_'+apt.id,
          aptId: apt.id,
          note: title,
          type: 'once',
          amount: share,
