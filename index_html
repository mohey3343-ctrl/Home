        const newId = inp.value.trim();
        if(!newId || newId===oldId){ inp.value = oldId; return; }
        if(state.apartments.some(a=>a.id===newId)){
          alert('رقم الشقة ده مستخدم بالفعل');
          inp.value = oldId;
          return;
        }
        const a = state.apartments.find(x=>x.id===oldId);
        a.id = newId;
        Object.values(state.payments).forEach(monthObj=>{
          if(monthObj[oldId]!==undefined){ monthObj[newId]=monthObj[oldId]; delete monthObj[oldId]; }
        });
        (state.commitments||[]).forEach(c=>{ if(c.aptId===oldId) c.aptId=newId; });
        persist(); renderAll();
      });
