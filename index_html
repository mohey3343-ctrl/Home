    <div class="stat"><div class="lbl">الشقق</div><div class="val num">${totalApts} <span style="font-size:11px;color:#c9c5e0">(${occupiedCount} مسكونة / ${vacantCount} شاغرة)</span></div></div>
    <div class="stat ${totalObligations>0?'balance-neg':''}"><div class="lbl">إجمالي الالتزامات المتبقية</div><div class="val num">${fmt(totalObligations)}</div></div>
    <div class="stat ${netKPI<0?'balance-neg':''}"><div class="lbl">الفائض / العجز بعد الالتزامات</div><div class="val num">${fmt(netKPI)}</div></div>
    <div class="stat"><div class="lbl">🛗 رصيد مشتركي الأسانسير</div><div class="val num">${fmt(elevatorFund)} <span style="font-size:11px;color:#c9c5e0">من ${fmt(balance)} إجمالي</span></div></div>
