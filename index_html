  const ledgerEntries = [
    {date: monthsRange(START_MONTH, currentMonth)[0]+'-01', note:'الرصيد الافتتاحي', amount: state.settings.openingBalance, kind:'opening'},
    ...state.fundLedger.map(f=>({date:f.date, note:f.note, amount:f.amount, kind:'manual', id:f.id})),
  ];
  Object.entries(state.payments).forEach(([mk, obj])=>{
    Object.entries(obj).forEach(([aptId, amt])=>{
      if(amt>0){
        const apt = state.apartments.find(a=>a.id===aptId);
        ledgerEntries.push({date:mk+'-01', note:'تحصيل من '+(apt?apt.name:aptId), amount:amt, kind:'payment', month:mk, aptId});
      }
    });
  });
  (state.commitmentPayments||[]).forEach(cp=>{
    const c = state.commitments.find(x=>x.id===cp.commitmentId);
    const isGeneral = c && !c.aptId;
    const amt = isGeneral ? -cp.amount : cp.amount;
    ledgerEntries.push({date:cp.date, note:'التزام'+(c?(' — '+(c.note||COMMITMENT_TYPES[c.type])):'')+' من '+(c?commitmentAptLabel(c):''), amount:amt, kind:'commitPay', id:cp.id});
  });
