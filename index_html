let state = null;
let currentTab = 'balance';
let currentMonth = '2026-08'; // YYYY-MM
let unlocked = false; // resets to locked/view-only every time the page loads — not persisted
let editingCommitId = null; // id of the commitment currently open for inline editing (apts tab)
let selectedCommitIds = new Set(); // ids of commitments ticked for bulk delete
let selectedArrearApts = new Set(); // apartment ids ticked for bulk settle in arrears report

function monthKey(y,m){ return y+'-'+String(m).padStart(2,'0'); }
function monthLabel(key){
  const [y,m] = key.split('-').map(Number);
  return MONTH_NAMES[m-1] + ' ' + y;
}
function shiftMonth(key, delta){
  let [y,m] = key.split('-').map(Number);
  m += delta;
  if(m>12){m=1;y++;} if(m<1){m=12;y--;}
  return monthKey(y,m);
}

/* ---------------- شيت جوجل كقاعدة بيانات مشتركة ---------------- */
/* غيّر الرابط ده لو عملت نشر (Deploy) جديد للسكريبت وطلع لك رابط مختلف */
const REMOTE_DB_URL = 'https://script.google.com/macros/s/AKfycbz1_5VB0BEdJt6w0GiajPA2Rwdyx63CWSaYhZ2EYfu9EG038vZmsgDleAYxZrW1-Ch3aA/exec';

let lastSyncedRaw = null;
let syncTimer = null;

function hasClaudeStorage(){
  return typeof window!=='undefined' && window.storage && typeof window.storage.get==='function';
}

function setSyncStatus(txt, isError){
  const el = document.getElementById('syncStatus');
  if(!el) return;
  el.textContent = txt;
  el.style.color = isError ? '#ffb3a3' : '#cfe9db';
}

async function storageGet(key){
  if(hasClaudeStorage()){
    try{
      const res = await window.storage.get(key, true);
      return res ? res.value : null;
    }catch(e){ /* not found yet, or storage not usable here */ }
  }
  if(REMOTE_DB_URL){
    try{
      const res = await fetch(REMOTE_DB_URL + '?key=' + encodeURIComponent(key), {cache:'no-store'});
      const json = await res.json();
      if(json && json.value){
        try{ localStorage.setItem(key, json.value); }catch(e){}
        setSyncStatus('🟢 متصل بجوجل شيت');
        return json.value;
      }
      setSyncStatus('🟢 متصل بجوجل شيت');
      return null;
    }catch(e){
      setSyncStatus('🟠 مفيش اتصال — بيشتغل من آخر نسخة محفوظة على الجهاز', true);
    }
  }
  try{ return localStorage.getItem(key); }catch(e){ return null; }
}

async function storageSet(key, value){
  if(hasClaudeStorage()){
    try{ await window.storage.set(key, value, true); return; }catch(e){ /* fall through to local */ }
  }
  try{ localStorage.setItem(key, value); }catch(e){ console.error('save failed', e); }
  if(REMOTE_DB_URL){
    try{
      await fetch(REMOTE_DB_URL, {
        method:'POST',
        headers:{'Content-Type':'text/plain;charset=utf-8'}, // نص عادي عشان نتفادى preflight من جوجل أبس سكريبت
        body: JSON.stringify({key, value})
      });
      setSyncStatus('🟢 متصل بجوجل شيت');
    }catch(e){
      setSyncStatus('🟠 التعديل محفوظ على جهازك بس — هيتزامن أول ما النت يرجع', true);
    }
  }
}

async function loadState(){
  const raw = await storageGet('data');
  if(raw){
    lastSyncedRaw = raw;
    state = JSON.parse(raw);
    migrateState();
    return;
  }
  state = seedState();
  await persist();
}

/* بيجيب آخر نسخة من جوجل شيت دوري، عشان أي حد غيّر حاجة يظهر التغيير عند الكل من غير ما يحتاج يعمل ريفريش يدوي.
   بيوقف أثناء ما حد فاتح وضع التعديل (unlocked) عشان مايبوظش حاجة وهو بيكتب. */
async function pollRemote(){
  if(unlocked) return;
  try{
    const raw = await storageGet('data');
    if(raw && raw !== lastSyncedRaw){
      lastSyncedRaw = raw;
      state = JSON.parse(raw);
      migrateState();
      renderAll();
    }
  }catch(e){ /* تجاهل أي خطأ مؤقت في الشبكة */ }
}
function startSyncPolling(){
  if(!REMOTE_DB_URL) return;
  if(syncTimer) clearInterval(syncTimer);
  syncTimer = setInterval(pollRemote, 20000); // كل 20 ثانية
  document.addEventListener('visibilitychange', ()=>{
    if(!document.hidden) pollRemote();
  });
}

function migrateState(){
  let changed = false;
  if(!state.settings){
    state.settings = { elevatorAmount:500, noElevatorAmount:450 };
    changed = true;
  }
  if(!state.settings.editPin){
    state.settings.editPin = '1234';
    changed = true;
  }
  if(typeof state.settings.unlockTaps !== 'number'){
    state.settings.unlockTaps = 4;
    changed = true;
  }
  if(typeof state.settings.changePinTaps !== 'number'){
    state.settings.changePinTaps = 7;
    changed = true;
  }
  if(typeof state.settings.openingBalance !== 'number'){
    const oldLedgerSum = (state.fundLedger||[]).reduce((s,f)=>s+f.amount,0);
    state.settings.openingBalance = oldLedgerSum || 4050;
    state.fundLedger = [];
    changed = true;
  }
  state.apartments.forEach(a=>{
    if(typeof a.elevator !== 'boolean'){
      a.elevator = a.floor !== 'الأرضي';
      changed = true;
    }
    if(typeof a.occupied !== 'boolean'){
      a.occupied = !!a.name;
      changed = true;
    }
    if(!Array.isArray(a.occupancyPeriods)){
      // بيانات قديمة: لو الشقة مأهولة حاليًا نعتبرها مأهولة من أول شهر متسجّل عندنا عشان مانخسرش المتأخرات القديمة
      a.occupancyPeriods = a.occupied ? [{from: START_MONTH, to: null}] : [];
      changed = true;
    }
  });
  if(!Array.isArray(state.commitments)){
    state.commitments = [];
    changed = true;
  }
  if(!Array.isArray(state.commitmentPayments)){
    state.commitmentPayments = [];
    changed = true;
  }
  if(!Array.isArray(state.elevatorSpends)){
    state.elevatorSpends = [];
    changed = true;
  }
  (state.commitments||[]).forEach(c=>{
    if(typeof c.fundType !== 'string'){
      c.fundType = 'general';
      changed = true;
    }
  });
  if(changed) persist();
}

async function persist(){
  const raw = JSON.stringify(state);
  lastSyncedRaw = raw;
  await storageSet('data', raw);
}

function fmt(n){
  n = Math.round(n);
  return n.toLocaleString('en-US');
}

function apartmentsByFloor(){
  const groups = {};
  state.apartments.forEach(a=>{
    if(!groups[a.floor]) groups[a.floor]=[];
    groups[a.floor].push(a);
  });
  return groups;
}

function isOccupiedInMonth(apt, monthKey){
  const periods = apt.occupancyPeriods || [];
  return periods.some(p => monthKey >= p.from && (p.to===null || monthKey < p.to));
}

function statusFor(apt, monthKey){
  if(!isOccupiedInMonth(apt, monthKey)) return 'vacant';
  const paid = (state.payments[monthKey]||{})[apt.id] || 0;
  if(paid<=0) return 'unpaid';
  if(paid>=apt.subscription) return 'paid';
  return 'partial';
}

function computeMonthTotals(monthKey){
  let expected=0, collected=0, outstanding=0;
  state.apartments.forEach(a=>{
    if(!isOccupiedInMonth(a, monthKey)) return;
    expected += a.subscription;
    const paid = (state.payments[monthKey]||{})[a.id] || 0;
    collected += paid;
    if(paid < a.subscription) outstanding++;
  });
  return {expected, collected, outstanding};
}

function computeFundBalance(){
  let bal = state.settings.openingBalance || 0;
  state.fundLedger.forEach(f=> bal += f.amount);
  Object.values(state.payments).forEach(monthObj=>{
    Object.values(monthObj).forEach(v=> bal += v);
  });
  (state.commitmentPayments||[]).forEach(cp=>{
    const c = state.commitments.find(x=>x.id===cp.commitmentId);
    if(c && !c.aptId){
      bal -= cp.amount; // سداد التزام عام (دين/فاتورة على العمارة) = فلوس بتخرج من الصندوق
    } else {
      bal += cp.amount; // تحصيل التزام إضافي من ساكن معيّن = فلوس بتدخل الصندوق
    }
  });
  state.expenses.forEach(e=> bal -= e.amount);
  (state.elevatorSpends||[]).forEach(sp=> bal -= sp.amount);
  return bal;
}

/* ---------------- COMMITMENTS (التزامات) ---------------- */
const COMMITMENT_TYPES = {
  once: 'مرة واحدة',
  monthly: 'شهري ثابت',
  installment: 'قسط شهري'
};

function commitmentTotalDue(c, uptoMonthKey){
  uptoMonthKey = uptoMonthKey || currentMonth;
  if(uptoMonthKey < c.startMonth) return 0;
  if(c.type==='once') return c.amount;
  const months = monthsRange(c.startMonth, uptoMonthKey).length;
  if(c.type==='installment') return Math.min(c.totalAmount||0, c.amount * months);
  // monthly: تراكم كل شهر من شهر البداية لحد الشهر الحالي
  return c.amount * months;
}

function commitmentPaidTotal(c){
  return (state.commitmentPayments||[])
    .filter(cp=>cp.commitmentId===c.id)
    .reduce((s,cp)=>s+cp.amount,0);
}

function commitmentRemaining(c, uptoMonthKey){
  const due = commitmentTotalDue(c, uptoMonthKey);
  const paid = commitmentPaidTotal(c);
  const rem = due - paid;
  return c.type==='monthly' ? rem : Math.max(0, rem);
}

function commitmentTotalRemaining(c){
  // remaining to fully close the commitment, regardless of how many months elapsed
  const total = c.type==='installment' ? (c.totalAmount||0) : commitmentTotalDue(c, currentMonth);
  return Math.max(0, total - commitmentPaidTotal(c));
}

function commitmentSuggestedAmount(c){
  const rem = commitmentRemaining(c, currentMonth);
  if(c.type==='monthly') return c.amount;
  return Math.max(0, Math.min(c.amount, rem));
}

function aptCommitments(aptId){
  return (state.commitments||[]).filter(c=>c.aptId===aptId && c.startMonth<=currentMonth);
}

function monthsRange(fromKey, toKey){
  const months = [];
  let cur = fromKey;
  // safety cap so a bad date never loops forever
  for(let i=0;i<240;i++){
    months.push(cur);
    if(cur===toKey) break;
    cur = shiftMonth(cur, 1);
  }
  return months;
}

function computeArrears(){
  const months = monthsRange(START_MONTH, currentMonth);
  const perApt = {}; // aptId -> {apt, total, items:[{label, owed}]}
  state.apartments.forEach(apt=>{
    months.forEach(mk=>{
      if(!isOccupiedInMonth(apt, mk)) return;
      const paid = (state.payments[mk]||{})[apt.id] || 0;
      const owed = apt.subscription - paid;
      if(owed>0){
        if(!perApt[apt.id]) perApt[apt.id] = {apt, total:0, items:[]};
        perApt[apt.id].total += owed;
        perApt[apt.id].items.push({label: monthLabel(mk), owed});
      }
    });
    aptCommitments(apt.id).forEach(c=>{
      const rem = commitmentRemaining(c, currentMonth);
      if(rem>0){
        if(!perApt[apt.id]) perApt[apt.id] = {apt, total:0, items:[]};
        perApt[apt.id].total += rem;
        perApt[apt.id].items.push({label: 'دين: ' + (c.note||COMMITMENT_TYPES[c.type]), owed: rem});
      }
    });
  });
  return Object.values(perApt).sort((a,b)=> b.total - a.total);
}

function settleArrearsForApt(aptId){
  const apt = state.apartments.find(a=>a.id===aptId);
  if(!apt) return;
  const months = monthsRange(START_MONTH, currentMonth);
  months.forEach(mk=>{
    if(!isOccupiedInMonth(apt, mk)) return;
    if(!state.payments[mk]) state.payments[mk] = {};
    const paid = state.payments[mk][apt.id] || 0;
    if(paid < apt.subscription){
      state.payments[mk][apt.id] = apt.subscription;
    }
  });
  aptCommitments(apt.id).forEach(c=>{
    const rem = commitmentRemaining(c, currentMonth);
    if(rem>0){
      if(!state.commitmentPayments) state.commitmentPayments=[];
      state.commitmentPayments.push({
        id:'cp'+Date.now()+Math.random().toString(36).slice(2,6),
        commitmentId:c.id, aptId:c.aptId, date: currentMonth+'-01', amount: rem
      });
    }
  });
}

function computeElevatorFundBalance(){
  // بيجمع بس الالتزامات اللي اتعلّمت "خاصة باشتراكات الأسانسير" — سواء تحصيل من ساكن مشترك جديد (بيزوّد الرصيد)
  // أو التزام عام مرتبط بالأسانسير بدون شقة معيّنة (بيقلل منه)، بالإضافة لعمليات الصرف اليدوي
  let bal = 0;
  (state.commitmentPayments||[]).forEach(cp=>{
    const c = state.commitments.find(x=>x.id===cp.commitmentId);
    if(c && c.fundType==='elevator'){
      bal += c.aptId ? cp.amount : -cp.amount;
    }
  });
  (state.elevatorSpends||[]).forEach(sp=> bal -= sp.amount);
  return bal;
}

function apartmentElevatorCredit(aptId){
  // الرصيد ده ملك مشترك لكل المشتركين في الأسانسير مع بعض (مش خاص بمين دفع بالظبط) — بيتقسم بالتساوي بينهم
  const apt = state.apartments.find(a=>a.id===aptId);
  if(!apt || !apt.elevator || !apt.occupied) return 0;
  const subscribers = state.apartments.filter(a=>a.occupied && a.elevator);
  if(subscribers.length===0) return 0;
  return computeElevatorFundBalance() / subscribers.length;
}

function computeTotalObligations(){
  // بس الالتزامات العامة على العمارة (بدون شقة) — مش المبالغ الإضافية المطلوبة من ساكن معيّن
  return (state.commitments||[]).filter(c=>!c.aptId).reduce((s,c)=> s + commitmentTotalRemaining(c), 0);
}

function commitmentAptLabel(c){
  if(!c.aptId) return 'التزام عام (بدون شقة)';
  const apt = state.apartments.find(a=>a.id===c.aptId);
  return apt ? (apt.name||apt.id) : c.aptId;
}

function computeMonthExpenses(monthKey){
  return state.expenses
    .filter(e=> e.date && e.date.slice(0,7)===monthKey)
    .reduce((s,e)=>s+e.amount,0);
}

