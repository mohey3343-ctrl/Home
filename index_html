<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>التقارير المالية برج الاندلس</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=El+Messiri:wght@500;700&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --night:#1b1f3f;
    --night-2:#282c66;
    --wall:#e8a53d;
    --wall-2:#f2c46b;
    --paper:#f8f7f4;
    --paper-2:#efece3;
    --ink:#211f2e;
    --ink-soft:#726f83;
    --lit:#e8a53d;
    --lit-glow:#f8cf8a;
    --dim:#4b4f7e;
    --vacant:#918bab;
    --good:#1f9d76;
    --bad:#e2573f;
    --line:#e6e0d3;
    --radius:16px;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'IBM Plex Sans Arabic', sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  .num{font-family:'IBM Plex Mono','IBM Plex Sans Arabic',monospace; font-weight:600;}
  h1,h2,h3{font-family:'El Messiri', sans-serif; margin:0;}

  /* ---------- HERO / FACADE ---------- */
  .hero{
    position:relative; overflow:hidden;
    background:linear-gradient(175deg, var(--night) 0%, var(--night-2) 100%);
    padding:16px 14px 20px;
    border-radius:0 0 22px 22px;
    box-shadow:0 10px 28px rgba(20,16,50,.18);
  }
  .hero::before{
    content:'';
    position:absolute; top:-120px; left:50%; transform:translateX(-50%);
    width:320px; height:320px; border-radius:50%;
    background:radial-gradient(circle, rgba(232,165,61,.30) 0%, rgba(232,165,61,0) 70%);
    pointer-events:none;
  }
  .hero > *{position:relative;}
  .hero-top{
    display:flex; align-items:center; justify-content:space-between;
    color:#fff; margin-bottom:12px;
  }
  .hero-title{color:#fff; font-size:23px; letter-spacing:.3px; font-weight:700;}
  .month-nav{display:flex; align-items:center; gap:10px; color:#fff;}
  .month-nav button{
    background:rgba(255,255,255,.15); border:1px solid rgba(255,255,255,.3);
    color:#fff; width:32px; height:32px; border-radius:50%;
    font-size:16px; cursor:pointer;
  }
  .month-nav button:active{background:rgba(255,255,255,.3);}
  .month-label{font-family:'IBM Plex Mono'; font-size:15px; min-width:110px; text-align:center;}

  .hero-title{cursor:default; user-select:none;}

  #lockBtn{
    background:transparent; border:none; color:transparent;
    width:6px; height:32px; font-size:0; cursor:default; padding:0;
  }
  #lockBtn.revealed{
    background:rgba(255,255,255,.15); border:1px solid rgba(255,255,255,.3);
    color:#fff; width:32px; border-radius:50%; font-size:14px; cursor:pointer;
  }
  #lockBtn.change-mode{
    background:rgba(255,255,255,.35); border:1px solid #fff;
  }
  #tapHint{
    font-size:10.5px; color:#fff; margin-inline-end:2px; white-space:nowrap;
  }
  #unlockPanel{
    display:none; background:rgba(255,255,255,.15); border:1px solid rgba(255,255,255,.3);
    border-radius:10px; padding:8px 10px; margin-bottom:12px; gap:8px;
  }
  #unlockPanel.show{display:flex; align-items:center;}
  #unlockPanel input{
    flex:1; border:1px solid rgba(255,255,255,.35); background:rgba(255,255,255,.12);
    color:#fff; border-radius:8px; padding:7px 10px; font-family:'IBM Plex Mono'; font-size:13px;
  }
  #unlockPanel button{
    background:#fff; color:var(--night); border:none; border-radius:8px;
    padding:7px 14px; font-size:12.5px; font-weight:700; cursor:pointer;
  }
  .view-only-banner{
    background:var(--paper-2); color:var(--ink-soft); font-size:12px; text-align:center;
    padding:8px 10px; border-radius:10px; margin-bottom:12px; border:1px solid var(--line);
  }
  #content.locked input, #content.locked select,
  #content.locked button.pill, #content.locked button.del,
  #content.locked form.inline button, #content.locked .preset,
  #content.locked input[type=checkbox]{
    pointer-events:none; opacity:.45;
  }
  .facade.locked .win{ pointer-events:none; }

  .balance-hero{
    background:rgba(255,255,255,.16); border:1px solid rgba(255,255,255,.3);
    border-radius:14px; padding:14px 16px; margin-bottom:12px; text-align:center;
  }
  .balance-hero .lbl{color:#e4e1f0; font-size:13px;}
  .balance-hero .val{color:#fff; font-size:40px; margin-top:4px; font-weight:700;}
  .balance-hero.balance-neg .val{color:#ffd0c8;}

  .facade{
    display:flex; flex-direction:column-reverse; gap:4px;
    background:rgba(255,255,255,.12); border-radius:10px; padding:9px 9px 7px;
    border:1px solid rgba(255,255,255,.25);
  }
  .floor-row{display:flex; align-items:center; gap:6px;}
  .floor-label{
    width:40px; flex-shrink:0; color:#e4e1f0; font-size:11px; font-weight:600; text-align:left;
    font-family:'IBM Plex Mono';
  }
  .windows{display:flex; gap:5px; flex:1;}
  .win{
    flex:1; min-width:0; height:42px; border-radius:8px; cursor:pointer;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    gap:1px; padding:0 3px;
    transition:transform .12s ease;
    border:1px solid rgba(0,0,0,.12);
  }
  .win .apt-num{
    font-size:13px; font-family:'IBM Plex Mono'; font-weight:700; line-height:1.15;
  }
  .win .apt-name{
    font-size:10px; font-family:'IBM Plex Sans Arabic'; font-weight:600; line-height:1.15;
    max-width:100%; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; opacity:.92;
  }
  .win:active{transform:scale(.94);}
  .win.paid{background:var(--lit); box-shadow:0 0 8px 0 rgba(232,165,61,.55); color:#241a04;}
  .win.partial{background:var(--dim); color:#fff; border-inline-start:3px solid var(--lit);}
  .win.unpaid{background:var(--dim); color:#fff;}
  .win.vacant{background:var(--vacant); color:#f3f0ea; border-style:dashed;}
  .win.vacant .apt-name{display:none;}

  .stats{
    display:grid; grid-template-columns:repeat(2,1fr); gap:8px; margin-bottom:12px;
  }
  .stat{
    background:rgba(255,255,255,.14); border:1px solid rgba(255,255,255,.26);
    border-radius:10px; padding:10px 12px;
  }
  .stat .lbl{color:#e4e1f0; font-size:12px;}
  .stat .val{color:#fff; font-size:25px; margin-top:2px;}
  .stat.balance-neg .val{color:#ffd0c8;}

  /* ---------- TABS ---------- */
  .tabbar{
    display:flex; background:var(--paper-2); border-bottom:1px solid var(--line);
    position:sticky; top:0; z-index:20; overflow-x:auto;
  }
  .tabbar button{
    flex:1; min-width:82px; background:none; border:none; padding:12px 6px;
    font-family:'IBM Plex Sans Arabic'; font-size:13px; color:var(--ink-soft);
    cursor:pointer; border-bottom:3px solid transparent; white-space:nowrap;
  }
  .tabbar button.active{color:var(--ink); border-bottom-color:var(--lit); font-weight:600;}

  .content{padding:14px 14px 60px; max-width:640px; margin:0 auto;}
  .card{
    background:#fff; border:1px solid var(--line); border-radius:var(--radius);
    padding:12px 14px; margin-bottom:10px;
    box-shadow:0 2px 10px rgba(33,31,46,.045);
  }
  .section-title{font-size:13px; color:var(--ink-soft); margin:16px 0 8px; font-weight:600;}
  .bulk-checkbox{
    width:16px; height:16px; flex-shrink:0; margin:2px 0 0; accent-color:var(--lit); cursor:pointer;
  }

  /* apartment row */
  .apt-row{
    display:flex; align-items:center; justify-content:space-between;
    padding:10px 0; border-bottom:1px solid var(--line);
    gap:8px;
  }
  .apt-row:last-child{border-bottom:none;}
  .apt-info{display:flex; flex-direction:column;}
  .apt-info .name{font-size:14.5px; font-weight:600;}
  .apt-info .meta{font-size:11.5px; color:var(--ink-soft);}
  .apt-actions{display:flex; align-items:center; gap:6px;}
  .amount-input{
    width:64px; text-align:center; border:1px solid var(--line); border-radius:8px;
    padding:6px 4px; font-family:'IBM Plex Mono'; font-size:13px;
  }
  .pill{
    font-size:11px; padding:5px 10px; border-radius:20px; border:none; cursor:pointer;
    font-family:'IBM Plex Sans Arabic'; font-weight:600;
  }
  .pill.pay{background:var(--good); color:#fff;}
  .pill.pay.done{background:#e9f5ef; color:var(--good); border:1px solid var(--good);}
  .vacant-tag{font-size:11px; color:var(--ink-soft); background:var(--paper-2); padding:4px 10px; border-radius:20px;}
  .export-btn{
    font-size:12px; padding:7px 14px; border-radius:20px; border:none; cursor:pointer;
    font-family:'IBM Plex Sans Arabic'; font-weight:600; background:var(--ink); color:#fff;
  }

  .floor-group-title{
    font-size:11px; color:#96907d; margin:14px 0 2px; letter-spacing:.5px;
  }

  /* expenses / fund list */
  .tx-row{
    display:flex; justify-content:space-between; align-items:center;
    padding:9px 0; border-bottom:1px solid var(--line); font-size:13.5px;
  }
  .tx-row:last-child{border-bottom:none;}
  .tx-main{display:flex; flex-direction:column;}
  .tx-main .note{font-weight:600;}
  .tx-main .date{font-size:11px; color:var(--ink-soft);}
  .tx-amt.out{color:var(--bad);}
  .tx-amt.in{color:var(--good);}

  form.inline{display:flex; flex-wrap:wrap; gap:8px; margin-top:6px;}
  form.inline input, form.inline select{
    border:1px solid var(--line); border-radius:8px; padding:8px 10px;
    font-family:'IBM Plex Sans Arabic'; font-size:13px; flex:1; min-width:100px;
  }
  form.inline button{
    background:var(--ink); color:#fff; border:none; border-radius:8px;
    padding:8px 16px; font-size:13px; cursor:pointer; font-weight:600;
  }
  .preset-row{display:flex; gap:6px; flex-wrap:wrap; margin-top:8px;}
  .preset{
    font-size:11.5px; background:var(--paper-2); border:1px solid var(--line);
    border-radius:20px; padding:5px 10px; cursor:pointer; color:var(--ink-soft);
  }

  .plan-row{display:flex; align-items:center; gap:10px; padding:9px 0; border-bottom:1px solid var(--line);}
  .plan-row:last-child{border-bottom:none;}
  .plan-row .item{flex:1; font-size:13.5px;}
  .plan-row.done .item{text-decoration:line-through; color:#a19c8c;}
  .plan-row input[type=checkbox]{width:18px; height:18px; accent-color:var(--good);}

  .empty{text-align:center; color:var(--ink-soft); font-size:13px; padding:20px 0;}
  .note-strip{
    background:#fbf3df; border:1px solid #e8d9a8; border-radius:10px; padding:9px 12px;
    font-size:12px; color:#7a6320; margin-bottom:12px;
  }
  .del{background:none; border:none; color:#b7a9a9; cursor:pointer; font-size:15px; padding:2px 6px;}
</style>
</head>
<body>

