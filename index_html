          <input type="checkbox" data-apt-elevator="${a.id}" ${a.elevator?'checked':''}> أسانسير
        </label>` : ''}
        <input type="number" class="amount-input" data-apt-sub="${a.id}" value="${a.subscription}" style="width:74px" ${a.occupied?'':'disabled'}>
        <button class="del" data-del-apt="${a.id}">✕</button>
      </div>
    </div>`;
  });
  html += `</div>`;

  html += `
    <div class="section-title">إضافة شقة</div>
    <div class="card">
      <form id="aptForm" class="inline">
        <input type="text" name="id" placeholder="رقم الشقة" required>
        <input type="text" name="floor" placeholder="الدور" required>
        <input type="text" name="name" placeholder="اسم الساكن">
        <input type="number" name="subscription" placeholder="الاشتراك الشهري" required>
        <button type="submit">إضافة</button>
      </form>
    </div>`;
  return html;
}

/* ---------------- EVENTS ---------------- */
function bindTabEvents(){
  if(currentTab==='collect'){
    document.querySelectorAll('.pay-amount').forEach(inp=>{
      inp.addEventListener('change', e=>{
        const aptId = e.target.dataset.apt;
        const val = Math.max(0, Number(e.target.value)||0);
        if(!state.payments[currentMonth]) state.payments[currentMonth]={};
        state.payments[currentMonth][aptId] = val;
        persist(); renderAll();
      });
    });
    document.querySelectorAll('[data-toggle]').forEach(btn=>{
      btn.addEventListener('click', ()=> quickTogglePaid(btn.dataset.toggle));
    });
    document.querySelectorAll('[data-commit-pay]').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        const cId = btn.dataset.commitPay;
        const c = state.commitments.find(x=>x.id===cId);
        if(!c) return;
        const inp = document.querySelector(`.commit-pay-amount[data-commit="${cId}"]`);
        const val = Number(inp.value) || commitmentSuggestedAmount(c);
        if(val<=0) return;
        if(!state.commitmentPayments) state.commitmentPayments=[];
        state.commitmentPayments.push({
          id:'cp'+Date.now(), commitmentId:cId, aptId:c.aptId,
          date: currentMonth+'-01', amount: val
        });
        persist(); renderAll();
      });
    });
    document.querySelectorAll('[data-del-commit]').forEach(b=>{
      b.addEventListener('click', ()=>{
        if(!confirm('متأكد إنك عايز تحذف الالتزام ده؟')) return;
        const id = b.dataset.delCommit;
        state.commitments = state.commitments.filter(c=>c.id!==id);
        state.commitmentPayments = (state.commitmentPayments||[]).filter(cp=>cp.commitmentId!==id);
        selectedCommitIds.delete(id);
        persist(); renderAll();
      });
    });
    document.querySelectorAll('[data-commit-select]').forEach(cb=>{
      cb.addEventListener('change', ()=>{
        const id = cb.dataset.commitSelect;
        if(cb.checked) selectedCommitIds.add(id); else selectedCommitIds.delete(id);
        renderAll();
      });
    });
    const selectAllCollectCommits = document.getElementById('selectAllCollectCommits');
    if(selectAllCollectCommits){
      selectAllCollectCommits.addEventListener('change', ()=>{
        const ids = collectTabCommitmentIds();
        if(selectAllCollectCommits.checked){
          ids.forEach(id=>selectedCommitIds.add(id));
        } else {
          ids.forEach(id=>selectedCommitIds.delete(id));
        }
        renderAll();
      });
    }
    const delSelectedCollectCommits = document.getElementById('delSelectedCollectCommits');
    if(delSelectedCollectCommits){
      delSelectedCollectCommits.addEventListener('click', ()=>{
        const ids = collectTabCommitmentIds().filter(id=>selectedCommitIds.has(id));
        if(ids.length===0) return;
        if(!confirm(`متأكد إنك عايز تحذف ${ids.length} التزام مرة واحدة؟`)) return;
        const idSet = new Set(ids);
        state.commitments = (state.commitments||[]).filter(c=>!idSet.has(c.id));
        state.commitmentPayments = (state.commitmentPayments||[]).filter(cp=>!idSet.has(cp.commitmentId));
        ids.forEach(id=>selectedCommitIds.delete(id));
        persist(); renderAll();
      });
    }
  }
  if(currentTab==='balance'){
    const spendForm = document.getElementById('elevatorSpendForm');
    if(spendForm) spendForm.addEventListener('submit', e=>{
      e.preventDefault();
      const f = e.target;
      const mode = f.mode.value;
      const note = f.note.value.trim();
      const totalAvailable = Math.max(0, computeElevatorFundBalance());
      if(totalAvailable<=0){
        alert('مفيش رصيد متجمّع من المشتركين دلوقتي.');
        return;
      }
      const spendAmount = mode==='all' ? totalAvailable : Math.min(totalAvailable, Number(f.amount.value)||0);
      if(spendAmount<=0){
        alert('لازم تدخل مبلغ أكبر من صفر.');
        return;
      }
      if(!state.elevatorSpends) state.elevatorSpends=[];
      state.elevatorSpends.push({
        id:'esp'+Date.now(), date: currentMonth+'-01', note: note||'صرف من رصيد الأسانسير',
        amount: spendAmount
      });
      persist(); renderAll();
      alert(`اتصرف ${fmt(spendAmount)} جنيه من رصيد الأسانسير المشترك.`);
    });
  }
  if(currentTab==='arrears'){
