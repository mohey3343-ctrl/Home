  ].map(a=>({id:a[0], floor:a[1], name:a[2], subscription:a[3], elevator:a[4], occupied: a[2]!==''}));

  return {
    apartments: apts,
    payments: { '2026-08': { '820': 500 } },
    expenses: [
      {id:'e1', date:'2026-07-01', category:'مياه', note:'مياه يوليه', amount:550}
    ],
    fundLedger: [],
    commitments: [],
    commitmentPayments: [],
    plans: [
      {id:'p1', item:'عتب أسانسير في كل دور', cost:2000, done:false},
      {id:'p2', item:'لوك باب عمارة + شفرات', cost:9000, done:false},
      {id:'p3', item:'كاميرات لكل دور والمدخل', cost:15000, done:false},
