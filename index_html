        persist(); renderAll();
      });
    });
    document.querySelectorAll('[data-apt-elevator]').forEach(cb=>{
      cb.addEventListener('change', ()=>{
        const a = state.apartments.find(x=>x.id===cb.dataset.aptElevator);
        a.elevator = cb.checked;
        a.subscription = a.elevator ? state.settings.elevatorAmount : state.settings.noElevatorAmount;
        persist(); renderAll();
      });
    });
    document.querySelectorAll('[data-apt-sub]').forEach(inp=>{
      inp.addEventListener('change', ()=>{
        const a = state.apartments.find(x=>x.id===inp.dataset.aptSub);
        a.subscription = Number(inp.value)||0;
        persist(); renderAll();
      });
    });
    document.querySelectorAll('[data-del-apt]').forEach(b=>{
      b.addEventListener('click', ()=>{
        state.apartments = state.apartments.filter(a=>a.id!==b.dataset.delApt);
        persist(); renderAll();
      });
    });
    document.getElementById('aptForm').addEventListener('submit', e=>{
      e.preventDefault();
      const f = e.target;
      state.apartments.push({
        id: f.id.value, floor: f.floor.value, name: f.name.value,
        subscription: Number(f.subscription.value)||0, elevator:true, occupied:true,
        occupancyPeriods: [{from: currentMonth, to: null}]
      });
      persist(); renderAll();
    });
  }
}

document.getElementById('tabbar').addEventListener('click', e=>{
  const btn = e.target.closest('button[data-tab]');
  if(!btn) return;
  currentTab = btn.dataset.tab;
  document.querySelectorAll('#tabbar button').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  renderAll();
});
document.getElementById('prevMonth').addEventListener('click', ()=>{
  currentMonth = shiftMonth(currentMonth, -1); renderAll();
});
document.getElementById('nextMonth').addEventListener('click', ()=>{
  currentMonth = shiftMonth(currentMonth, 1); renderAll();
});

let titleTaps = [];
let pendingIntent = 'unlock'; // 'unlock' or 'changePin'
document.querySelector('.hero-title').addEventListener('click', ()=>{
  const now = Date.now();
  titleTaps.push(now);
  titleTaps = titleTaps.filter(t => now - t < 4000);
  const s = state && state.settings;
  if(!s) return;
  const needed = s.unlockTaps || 4;
  const neededChange = s.changePinTaps || 7;
  if(titleTaps.length >= neededChange){
    pendingIntent = 'changePin';
    document.getElementById('lockBtn').classList.add('revealed');
  } else if(titleTaps.length >= needed){
    pendingIntent = 'unlock';
    document.getElementById('lockBtn').classList.add('revealed');
  }
});

document.getElementById('lockBtn').addEventListener('click', ()=>{
  if(unlocked){
    lockNow();
    return;
  }
  document.getElementById('unlockPanel').classList.toggle('show');
  document.getElementById('pinInput').focus();
});
document.getElementById('pinSubmit').addEventListener('click', tryUnlock);
document.getElementById('pinInput').addEventListener('keydown', e=>{
  if(e.key==='Enter') tryUnlock();
});
function tryUnlock(){
  const val = document.getElementById('pinInput').value;
  if(val === state.settings.editPin){
    unlocked = true;
    document.getElementById('unlockPanel').classList.remove('show');
    document.getElementById('pinInput').value='';
    if(pendingIntent==='changePin'){
      currentTab = 'apts';
      document.querySelectorAll('#tabbar button').forEach(b=>b.classList.toggle('active', b.dataset.tab==='apts'));
    }
    pendingIntent = 'unlock';
    titleTaps = [];
    renderAll();
    resetIdleTimer();
  } else {
    document.getElementById('pinInput').value='';
  }
}

function lockNow(){
  unlocked = false;
  document.getElementById('lockBtn').classList.remove('revealed');
  document.getElementById('unlockPanel').classList.remove('show');
  if(idleTimer) clearTimeout(idleTimer);
  renderAll();
}

/* قفل تلقائي بعد فترة عدم استخدام، أو لما الصفحة تتخبى/تتقفل */
let idleTimer = null;
function resetIdleTimer(){
  if(idleTimer) clearTimeout(idleTimer);
  if(!unlocked) return;
  idleTimer = setTimeout(lockNow, 3*60*1000); // 3 دقايق من غير أي تعديل
}
document.addEventListener('click', ()=>{ if(unlocked) resetIdleTimer(); });
document.addEventListener('input', ()=>{ if(unlocked) resetIdleTimer(); });
document.addEventListener('visibilitychange', ()=>{
  if(document.hidden && unlocked) lockNow();
});
window.addEventListener('pagehide', ()=>{
  if(unlocked) lockNow();
});

(async function init(){
  await loadState();
  renderAll();
