    if(le.kind==='manual') delAttr = `data-del-fund="${le.id}"`;
    else if(le.kind==='commitPay') delAttr = `data-del-commitpay="${le.id}"`;
    else if(le.kind==='expense') delAttr = `data-del-exp-fund="${le.id}"`;
    else if(le.kind==='payment') delAttr = `data-del-payment="${le.month}|${le.aptId}"`;
    else if(le.kind==='elevatorSpend') delAttr = `data-del-elevator-spend="${le.id}"`;
    const delBtn = delAttr ? `<button class="del" ${delAttr}>✕</button>` : '';
    html += `<div class="tx-row"><div class="tx-main"><div class="note">${le.note}</div><div class="date">${le.date}</div></div><div style="display:flex;align-items:center;gap:6px"><div class="tx-amt ${le.amount<0?'out':'in'} num">${le.amount<0?'-':'+'}${fmt(Math.abs(le.amount))}</div>${delBtn}</div></div>`;
  });
