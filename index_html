function quickTogglePaid(aptId){
  if(!unlocked) return;
  const apt = state.apartments.find(a=>a.id===aptId);
  if(!apt) return;
  if(!state.payments[currentMonth]) state.payments[currentMonth]={};
  const current = state.payments[currentMonth][aptId]||0;
  state.payments[currentMonth][aptId] = current>=apt.subscription ? 0 : apt.subscription;
  persist();
  renderAll();
}

