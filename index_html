function exportReportCSV(){
  const arrears = computeArrears();
  const totalOwed = arrears.reduce((s,a)=>s+a.total,0);
  const balance = computeFundBalance();
  const rows = [];
  rows.push(['التقارير المالية برج الاندلس', monthLabel(currentMonth)]);
  rows.push(['رصيد الصندوق', balance]);
  rows.push(['إجمالي المتأخرات', totalOwed]);
  rows.push([]);
  rows.push(['رقم الشقة','اسم الساكن','البنود المتأخرة','إجمالي المستحق']);
  arrears.forEach(a=>{
    rows.push([a.apt.id, a.apt.name||'—', a.items.map(m=>m.label+' ('+m.owed+')').join(' / '), a.total]);
  });
  const csv = '\uFEFF' + rows.map(r=> r.map(cell=>{
    const s = String(cell==null?'':cell);
    return /[",\n]/.test(s) ? '"'+s.replace(/"/g,'""')+'"' : s;
  }).join(',')).join('\n');
  const blob = new Blob([csv], {type:'text/csv;charset=utf-8;'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'تقرير-المتاخرات-'+currentMonth+'.csv';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

