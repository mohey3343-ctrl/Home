    ledgerEntries.push({date:e.date, note:e.category+(e.note?(' — '+e.note):''), amount:-e.amount, kind:'expense', id:e.id});
  });
  (state.elevatorSpends||[]).forEach(sp=>{
    ledgerEntries.push({date:sp.date, note:'🛗 صرف من رصيد الأسانسير — '+sp.note, amount:-sp.amount, kind:'elevatorSpend', id:sp.id});
  });
  ledgerEntries.sort((a,b)=> a.date.localeCompare(b.date));
  if(ledgerEntries.length===0) html += `<div class="empty">مفيش حركات لسه</div>`;
  ledgerEntries.forEach(le=>{
